@{
    ViewData["Title"] = "Chat Support";
}

<link rel="stylesheet" href="~/css/chat.css" />

<section class="chat-shell" aria-labelledby="chat-title">
    <header class="chat-heading">
        <p class="chat-eyebrow">GloboTicket assistant</p>
        <h1 id="chat-title">Find your next live event.</h1>
        <p class="chat-summary">
            Ask about upcoming concerts, dates, venues, and ticket options. Responses stream
            into this custom SignalR chat as the assistant works.
        </p>
    </header>

    <section class="chat-workspace" aria-labelledby="workspace-title">
        <header class="workspace-heading">
            <div>
                <p class="workspace-kicker">Live support</p>
                <h2 id="workspace-title">SignalR chat</h2>
                <p>The browser receives each response incrementally through application-specific hub events.</p>
            </div>
            <div class="chat-status" role="status" aria-live="polite">
                <span class="chat-status-dot" aria-hidden="true"></span>
                <span id="signalrConnectionStatus">Connecting to hub</span>
            </div>
        </header>

        <div class="chat-thread" id="signalrChatThread">
            <ol id="signalrMessagesList" class="chat-messages" aria-live="polite" aria-relevant="additions text"></ol>
            <div id="signalrEmptyState" class="chat-empty">
                <span class="chat-empty-mark" aria-hidden="true">GT</span>
                <h3>Ask about upcoming events</h3>
                <p>Try “Which concerts are available?” to get started.</p>
            </div>
        </div>

        <form id="signalrChatForm" class="chat-composer">
            <label class="visually-hidden" for="signalrMessageInput">Message the GloboTicket assistant</label>
            <input type="text" class="chat-input" id="signalrMessageInput"
                   placeholder="Ask about concerts, dates, or venues" autocomplete="off" />
            <button type="submit" id="signalrSendButton" class="chat-send">Send</button>
        </form>
    </section>
</section>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/signalr-chat.js"></script>
