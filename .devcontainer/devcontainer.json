{
  "name": "AgentFrameworkWorkshop",
  "image": "mcr.microsoft.com/devcontainers/dotnet:dev-10.0-noble",
  "onCreateCommand": "curl -sSL https://aspire.dev/install.sh | bash",
  "postCreateCommand": "python3 -m pip install --upgrade pip && python3 -m pip install pypdf pdfplumber",
  "postStartCommand": "dotnet dev-certs https --trust || true; grep -q 'SSL_CERT_DIR' \"$HOME/.bashrc\" || echo 'export SSL_CERT_DIR=\"$HOME/.aspnet/dev-certs/trust:/usr/lib/ssl/certs\"' >> \"$HOME/.bashrc\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker",
        "github.copilot",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "moby": true,
      "azureDnsAutoDetection": true,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true,
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.2": {},
    "ghcr.io/devcontainers/features/powershell:2.0.3": {},
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {},
    "ghcr.io/devcontainers/features/python:1": {}
  }

}